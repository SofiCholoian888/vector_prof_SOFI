# App
NODE_ENV=development
PORT=3000
# Не используется как механизм авторизации. X-Session-ID — идентификатор сессии, не секрет доступа.
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL (local Docker)
DATABASE_URL=postgresql://navigator:navigator_dev_password@localhost:5433/navigator

# For container-to-container connections use:
# DATABASE_URL=postgresql://navigator:navigator_dev_password@db:5432/navigator

# Supabase / hosted Postgres example (fictitious values only):
# DATABASE_URL=postgresql://postgres.xxxx:replace-with-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=true

# AI Gateway (OpenAI-compatible API for GigaChat)
AI_API_BASE_URL=https://litellmru.ds-hub-cf.ru/v1
AI_API_KEY=replace-with-ai-gateway-key
AI_MODEL=GigaChat-3-Lightning
AI_TIMEOUT_MS=45000
LLM_EMBEDDINGS_MODEL=EmbeddingsGigaR
EMBEDDING_QUERY_MODE=plain

# Account registration. Production stays closed until http or smtp delivery is set.
AUTH_REGISTRATION_ENABLED=false
AUTH_CHALLENGE_SECRET=replace-with-a-long-random-secret
AUTH_EMAIL_TRANSPORT=
AUTH_DELIVERY_URL=
AUTH_DELIVERY_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Workshop is closed until policy and acceptance are approved. Independent of diagnostic queue.
ASSISTANT_ENABLED=false
# Explicit product decision required; blank values fail closed on POST.
ASSISTANT_DAILY_LIMIT=
ASSISTANT_RETENTION_DAYS=
# Technical protection for the NEW workshop only; not a measured capacity guarantee.
ASSISTANT_MAX_CONCURRENT=5
